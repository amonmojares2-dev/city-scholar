# Email delivery through Brevo HTTPS API (configure real values in Render; never commit secrets)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=City Scholar <your_verified_sender@example.com>

# ---------------------------------------------------------------
# AI grade extraction (Google Gemini) — REQUIRED for the Analyze button on
# the City Office Academic Monitoring page (/city/academic).
#
# This is the only part of the system with a per-call cost. Without
# GEMINI_API_KEY set, the Academic page still loads and lists scholars,
# but the Analyze action returns 503 with an explanatory message.
#
# GEMINI_API_KEY       required — your Google Gemini API key
# GEMINI_VISION_MODEL  required — Gemini vision model
# ---------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
