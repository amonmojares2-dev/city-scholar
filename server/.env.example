# Email delivery through Brevo HTTPS API (configure real values in Render; never commit secrets)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=City Scholar <your_verified_sender@example.com>

# ---------------------------------------------------------------
# AI grade extraction (OpenAI) — REQUIRED for the Analyze button on
# the City Office Academic Monitoring page (/city/academic).
#
# This is the only part of the system with a per-call cost. Without
# OPENAI_API_KEY set, the Academic page still loads and lists scholars,
# but the Analyze action returns 503 with an explanatory message.
#
# OPENAI_API_KEY       required — your OpenAI platform API key
# OPENAI_VISION_MODEL  optional — defaults to "gpt-4o" (handles PNG, JPEG, PDF)
# ---------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_VISION_MODEL=gpt-4o
